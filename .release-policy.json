{
  "repository": "ha-homelab/ha-echo-dot",
  "mode": "release",
  "default_branch": "main",
  "visibility": "public",
  "version_file": "VERSION",
  "validation_workflows": [
    "tests.yml",
    "codeql.yml",
    "dependency-review.yml"
  ],
  "artifact_pattern": "release-assets*",
  "local_checks": [
    "python3 scripts/test_prepare_public_release.py",
    "python3 scripts/test_package_host_tools.py",
    "python3 scripts/prepare_public_release.py --check-only",
    "go -C training/validation test -race ./..."
  ],
  "notes": [
    "Releases contain only allowlisted public host-tool source, documentation, recipes and dependency/test metadata; no firmware, model weights, datasets, recordings or credentials.",
    "The host-tools VERSION is independent of EchoLocal, Fire OS, TWRP and trained-model versions.",
    "Synthetic Python and Go validation does not establish hardware compatibility, acoustic acceptance or TensorFlow model parity.",
    "Existing ownership and license notices are preserved; this release does not introduce a new license grant."
  ],
  "release_notes": "CHANGELOG.md",
  "single_entry_ci": true,
  "fuzzing": {
    "toolkit_ref": "5b498755c6357b034be0221f51633bab69e2380e"
  },
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "files": [
      {
        "path": "VERSION",
        "format": "text",
        "value": "package"
      }
    ],
    "artifacts": [
      {
        "path": "ha-echo-dot-public-tools.tar.gz",
        "format": "tar-text",
        "member": "ha-echo-dot-public-tools/VERSION",
        "value": "package"
      },
      {
        "path": "ha-echo-dot-public-tools.version.json",
        "format": "json",
        "field": "version",
        "value": "package"
      }
    ],
    "toolkit_revision": "5b498755c6357b034be0221f51633bab69e2380e"
  },
  "toolkit_revision": "5b498755c6357b034be0221f51633bab69e2380e"
}
